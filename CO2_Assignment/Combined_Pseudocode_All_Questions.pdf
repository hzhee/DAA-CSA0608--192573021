45 725.0 Td (  Total candidates = 2^n subsets.) Tj
45 713.0 Td () Tj
45 701.0 Td (ALGORITHM: ExhaustiveKnapsack\(packages, W\)) Tj
45 689.0 Td (-------------------------------------------) Tj
45 677.0 Td (  best_value <- 0 | best_subset <- {} | combos <- 0) Tj
45 665.0 Td () Tj
45 653.0 Td (  FOR mask <- 0 TO 2^n - 1 DO) Tj
45 641.0 Td (      combos <- combos + 1) Tj
