45 473.0 Td () Tj
45 461.0 Td (ALGORITHM: BruteForceClosestPair\(P[0..n-1]\)) Tj
45 449.0 Td (---------------------------------------------) Tj
45 437.0 Td (// Find the pair of points with minimum Euclidean distance.) Tj
45 425.0 Td () Tj
45 413.0 Td (  min_dist   <- INFINITY) Tj
45 401.0 Td (  pair       <- \(-1, -1\)) Tj
45 389.0 Td (  dist_calcs <- 0) Tj
45 377.0 Td () Tj
45 365.0 Td (  FOR i <- 0 TO n-2 DO) Tj
45 353.0 Td (      FOR j <- i+1 TO n-1 DO) Tj
45 341.0 Td (          dist_calcs <- dist_calcs + 1) Tj
45 329.0 Td (          d <- SQRT\(\(P[i].x - P[j].x\)^2 + \(P[i].y - P[j].y\)^2\)) Tj
45 317.0 Td (          IF d < min_dist THEN) Tj
45 305.0 Td (              min_dist <- d) Tj
45 293.0 Td (              pair     <- \(i, j\)) Tj
45 281.0 Td (          END IF) Tj
45 269.0 Td (      END FOR) Tj
45 257.0 Td (  END FOR) Tj
45 245.0 Td (  RETURN pair, min_dist, dist_calcs) Tj
45 233.0 Td () Tj
45 221.0 Td (Step-by-Step Logic:) Tj
45 209.0 Td (  1. Initialise min_dist = infinity.) Tj
45 197.0 Td (  2. Use i < j to consider each unordered pair exactly once.) Tj
45 185.0 Td (  3. For each pair compute Euclidean distance d\(P_i, P_j\).) Tj
45 173.0 Td (  4. If d < current minimum: update minimum and record pair.) Tj
45 161.0 Td (  5. After ALL pairs examined: return closest pair and distance.) Tj
45 149.0 Td () Tj
45 137.0 Td (CANDIDATE REPRESENTATION:) Tj
45 125.0 Td (  Each candidate = unordered pair {i,j}, i < j.) Tj
45 113.0 Td (  Total = C\(n,2\) = n\(n-1\)/2.) Tj
45 101.0 Td (  n=10: 45 | n=100: 4,950 | n=1000: 499,500) Tj
45 89.0 Td () Tj
45 77.0 Td (COMPLEXITY:) Tj
45 65.0 Td (  T\(n\) = n\(n-1\)/2 in Theta\(n^2\)) Tj
45 53.0 Td (  When n doubles: calculations quadruple \(confirmed O\(n^2\)\).) Tj
ET
