45 617.0 Td (ALGORITHM 1: SelectionSort\(A[0..n-1]\)) Tj
45 605.0 Td (---------------------------------------) Tj
45 593.0 Td (// Sort by repeatedly selecting the minimum element.) Tj
45 581.0 Td (// Input: Array A of n elements | Output: Sorted A, comparison count) Tj
45 569.0 Td () Tj
45 557.0 Td (  comparisons <- 0) Tj
45 545.0 Td (  FOR i <- 0 TO n-2 DO) Tj
45 533.0 Td (      min_idx <- i) Tj
45 521.0 Td (      FOR j <- i+1 TO n-1 DO) Tj
45 509.0 Td (          comparisons <- comparisons + 1) Tj
45 497.0 Td (          IF A[j] < A[min_idx] THEN  min_idx <- j  END IF) Tj
45 485.0 Td (      END FOR) Tj
45 473.0 Td (      IF min_idx != i THEN  SWAP\(A[i], A[min_idx]\)  END IF) Tj
45 461.0 Td (  END FOR) Tj
45 449.0 Td (  RETURN A, comparisons) Tj
45 437.0 Td () Tj
45 425.0 Td (Step-by-Step Logic:) Tj
45 413.0 Td (  1. Assume first element of unsorted portion is minimum.) Tj
45 401.0 Td (  2. Scan remaining unsorted elements \(inner loop, n-1-i comparisons\).) Tj
45 389.0 Td (  3. After full scan, swap minimum element to front of unsorted portion.) Tj
45 377.0 Td (  4. Advance boundary: unsorted portion shrinks by 1.) Tj
45 365.0 Td (  5. Repeat n-1 times until entire array is sorted.) Tj
45 353.0 Td () Tj
45 341.0 Td (Complexity: Best=O\(n^2\) | Average=O\(n^2\) | Worst=O\(n^2\)) Tj
45 329.0 Td (Mathematical: Comparisons = n\(n-1\)/2 always \(e.g. n=1000 -> 499,500\)) Tj
45 317.0 Td (Characteristic: NOT adaptive ? always O\(n^2\) regardless of input order.) Tj
45 305.0 Td () Tj
45 293.0 Td () Tj
45 281.0 Td (ALGORITHM 2: BubbleSort\(A[0..n-1]\)) Tj
45 269.0 Td (------------------------------------) Tj
45 257.0 Td (// Sort by repeatedly swapping adjacent out-of-order elements.) Tj
45 245.0 Td () Tj
45 233.0 Td (  comparisons <- 0) Tj
45 221.0 Td (  FOR i <- 0 TO n-2 DO) Tj
45 209.0 Td (      swapped <- FALSE) Tj
45 197.0 Td (      FOR j <- 0 TO n-2-i DO) Tj
45 185.0 Td (          comparisons <- comparisons + 1) Tj
45 173.0 Td (          IF A[j] > A[j+1] THEN) Tj
45 161.0 Td (              SWAP\(A[j], A[j+1]\)) Tj
45 149.0 Td (              swapped <- TRUE) Tj
45 137.0 Td (          END IF) Tj
45 125.0 Td (      END FOR) Tj
45 113.0 Td (      IF NOT swapped THEN BREAK  END IF     // Early termination) Tj
45 101.0 Td (  END FOR) Tj
45 89.0 Td (  RETURN A, comparisons) Tj
45 77.0 Td () Tj
45 65.0 Td (Step-by-Step Logic:) Tj
45 53.0 Td (  1. Each pass bubbles the largest unsorted element to its final position.) Tj
ET
