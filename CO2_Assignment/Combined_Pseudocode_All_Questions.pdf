45 305.0 Td () Tj
45 293.0 Td (ALGORITHM: BruteForceStringMatch\(text[0..n-1], pattern[0..m-1]\)) Tj
45 281.0 Td (-----------------------------------------------------------------) Tj
45 269.0 Td (// Find all occurrences of pattern in text.) Tj
45 257.0 Td () Tj
45 245.0 Td (  comparisons <- 0) Tj
45 233.0 Td (  FOR i <- 0 TO n-m DO) Tj
45 221.0 Td (      j <- 0) Tj
45 209.0 Td (      WHILE j < m AND text[i+j] = pattern[j] DO) Tj
45 197.0 Td (          comparisons <- comparisons + 1) Tj
45 185.0 Td (          j <- j + 1) Tj
45 173.0 Td (      END WHILE) Tj
45 161.0 Td (      IF j < m THEN comparisons <- comparisons + 1 END IF) Tj
45 149.0 Td (      IF j = m THEN REPORT match at position i END IF) Tj
45 137.0 Td (  END FOR) Tj
45 125.0 Td (  RETURN comparisons) Tj
45 113.0 Td () Tj
45 101.0 Td (Step-by-Step Logic:) Tj
45 89.0 Td (  1. Align pattern at position i=0 in the text.) Tj
45 77.0 Td (  2. Compare characters left-to-right until mismatch or full match.) Tj
45 65.0 Td (  3. If all m characters match: pattern found at index i.) Tj
45 53.0 Td (  4. If mismatch: shift pattern one position right \(i <- i+1\).) Tj
ET
