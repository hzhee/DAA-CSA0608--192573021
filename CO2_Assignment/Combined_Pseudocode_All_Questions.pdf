45 617.0 Td (      FOR i <- 0 TO n-1 DO) Tj
45 605.0 Td (          IF BIT\(mask, i\) = 1 THEN) Tj
45 593.0 Td (              curr_w <- curr_w + packages[i].weight) Tj
45 581.0 Td (              curr_v <- curr_v + packages[i].value) Tj
45 569.0 Td (              APPEND i TO curr_s) Tj
45 557.0 Td (          END IF) Tj
45 545.0 Td (      END FOR) Tj
45 533.0 Td (      IF curr_w <= W AND curr_v > best_value THEN) Tj
45 521.0 Td (          best_value <- curr_v | best_subset <- curr_s) Tj
