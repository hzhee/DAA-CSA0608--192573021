45 677.0 Td () Tj
45 665.0 Td (GEOMETRIC TEST:) Tj
45 653.0 Td (  For directed edge P_i -> P_j and test point P_k:) Tj
45 641.0 Td (    cross = \(P_j.x - P_i.x\)\(P_k.y - P_i.y\) - \(P_j.y - P_i.y\)\(P_k.x - P_i.x\)) Tj
45 629.0 Td (    cross > 0 => P_k LEFT of edge | cross < 0 => P_k RIGHT | cross=0 => collinear) Tj
45 617.0 Td () Tj
45 605.0 Td (ALGORITHM: BruteForceConvexHull\(P[0..n-1]\)) Tj
45 593.0 Td (--------------------------------------------) Tj
45 581.0 Td (// Find all directed edges that form the convex hull boundary.) Tj
45 569.0 Td () Tj
45 557.0 Td (  hull_edges  <- empty set) Tj
45 545.0 Td (  edge_checks <- 0) Tj
45 533.0 Td () Tj
45 521.0 Td (  FOR i <- 0 TO n-1 DO) Tj
45 509.0 Td (      FOR j <- 0 TO n-1 DO) Tj
45 497.0 Td (          IF i = j THEN CONTINUE END IF) Tj
45 485.0 Td (          all_same_side <- TRUE) Tj
45 473.0 Td (          sign          <- 0) Tj
45 461.0 Td () Tj
45 449.0 Td (          FOR k <- 0 TO n-1 DO) Tj
45 437.0 Td (              IF k = i OR k = j THEN CONTINUE END IF) Tj
45 425.0 Td (              edge_checks <- edge_checks + 1) Tj
45 413.0 Td (              cross <- \(P[j].x-P[i].x\)\(P[k].y-P[i].y\) - \(P[j].y-P[i].y\)\(P[k].x-P[i].x\)) Tj
45 401.0 Td (              IF cross != 0 THEN) Tj
45 389.0 Td (                  s <- SIGN\(cross\)) Tj
45 377.0 Td (                  IF sign = 0 THEN sign <- s) Tj
45 365.0 Td (                  ELSE IF s != sign THEN all_same_side <- FALSE; BREAK) Tj
45 353.0 Td (                  END IF) Tj
45 341.0 Td (              END IF) Tj
45 329.0 Td (          END FOR) Tj
45 317.0 Td (          IF all_same_side THEN ADD \(i,j\) TO hull_edges END IF) Tj
45 305.0 Td (      END FOR) Tj
45 293.0 Td (  END FOR) Tj
45 281.0 Td (  RETURN UNIQUE_VERTICES\(hull_edges\), edge_checks) Tj
45 269.0 Td () Tj
45 257.0 Td (CORRECTNESS ARGUMENT \(Geometric Reasoning\):) Tj
45 245.0 Td (  An edge \(P_i -> P_j\) lies on the convex hull if and only if ALL other) Tj
45 233.0 Td (  points lie on the SAME SIDE of the directed line P_i->P_j.) Tj
45 221.0 Td () Tj
45 209.0 Td (  WHY: The convex hull is the smallest convex polygon containing all points.) Tj
45 197.0 Td (  By convexity, every hull edge must have ALL points on one interior side.) Tj
45 185.0 Td (  If even ONE point is on the opposite side, the polygon is non-convex there) Tj
45 173.0 Td (  -- a contradiction. The cross product sign reveals which side P_k is on.) Tj
45 161.0 Td (  Same sign for all k => all points on one side => valid hull edge.) Tj
45 149.0 Td (  This is a geometric necessity, not an empirical observation.) Tj
45 137.0 Td () Tj
45 125.0 Td (COMPLEXITY: T\(n\) = n\(n-1\)\(n-2\) in O\(n^3\)) Tj
45 113.0 Td (  When n doubles: checks multiply by ~8 \(confirmed: 10->720, 20->6840 ~9.5x\).) Tj
45 101.0 Td () Tj
45 89.0 Td () Tj
