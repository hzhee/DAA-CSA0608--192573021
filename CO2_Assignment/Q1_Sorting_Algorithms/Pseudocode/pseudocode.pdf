(ALGORITHM 3: InsertionSort\(A[0..n-1]\)) Tj
50 379.0 Td
(---------------------------------------) Tj
50 366.0 Td
(// Insert each element into its correct position in the sorted prefix) Tj
50 353.0 Td
(// Input : Array A of n comparable elements) Tj
50 340.0 Td
(// Output: Sorted A, comparison count) Tj
50 327.0 Td
() Tj
50 314.0 Td
(  comparisons <- 0) Tj
50 301.0 Td
(  FOR i <- 1 TO n-1 DO) Tj
50 288.0 Td
(      key <- A[i]) Tj
50 275.0 Td
(      j   <- i - 1) Tj
50 262.0 Td
(      WHILE j >= 0 AND A[j] > key DO) Tj
50 249.0 Td
(          comparisons <- comparisons + 1) Tj
50 236.0 Td
(          A[j+1] <- A[j]           // Shift right) Tj
50 223.0 Td
(          j <- j - 1) Tj
50 210.0 Td
(      END WHILE) Tj
50 197.0 Td
(      IF j >= 0 THEN) Tj
50 184.0 Td
(          comparisons <- comparisons + 1   // The final failing comparison) Tj
50 171.0 Td
(      END IF) Tj
50 158.0 Td
(      A[j+1] <- key) Tj
50 145.0 Td
(  END FOR) Tj
50 132.0 Td
(  RETURN A, comparisons) Tj
50 119.0 Td
() Tj
50 106.0 Td
(Step-by-Step Logic:) Tj
50 93.0 Td
(  1. Treat A[0] as a one-element sorted sub-array.) Tj
50 80.0 Td
(  2. Pick next element \(key = A[i]\).) Tj
50 67.0 Td
(  3. Walk backwards through sorted portion.) Tj
