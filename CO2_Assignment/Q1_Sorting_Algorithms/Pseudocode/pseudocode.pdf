50 125.0 Td
(------------------------------------) Tj
50 112.0 Td
(// Repeatedly swap adjacent elements that are out of order) Tj
50 99.0 Td
(// Input : Array A of n comparable elements) Tj
50 86.0 Td
(// Output: Sorted A, comparison count) Tj
50 73.0 Td
() Tj
