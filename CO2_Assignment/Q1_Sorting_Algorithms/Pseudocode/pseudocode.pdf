(ALGORITHM 1: SelectionSort\(A[0..n-1]\)) Tj
50 593.0 Td
(--------------------------------------) Tj
50 580.0 Td
(// Sorts array A by repeatedly selecting the minimum element) Tj
50 567.0 Td
(// Input : Array A of n comparable elements) Tj
50 554.0 Td
(// Output: Sorted A, comparison count) Tj
50 541.0 Td
() Tj
50 528.0 Td
(  comparisons <- 0) Tj
50 515.0 Td
(  FOR i <- 0 TO n-2 DO) Tj
50 502.0 Td
(      min_idx <- i) Tj
50 489.0 Td
(      FOR j <- i+1 TO n-1 DO) Tj
50 476.0 Td
(          comparisons <- comparisons + 1) Tj
50 463.0 Td
(          IF A[j] < A[min_idx] THEN) Tj
50 450.0 Td
(              min_idx <- j) Tj
50 437.0 Td
(          END IF) Tj
50 424.0 Td
(      END FOR) Tj
50 411.0 Td
(      IF min_idx != i THEN) Tj
50 398.0 Td
(          SWAP\(A[i], A[min_idx]\)) Tj
50 385.0 Td
(      END IF) Tj
50 372.0 Td
(  END FOR) Tj
50 359.0 Td
(  RETURN A, comparisons) Tj
50 346.0 Td
() Tj
50 333.0 Td
(Step-by-Step Logic:) Tj
50 320.0 Td
(  1. Assume first element of unsorted portion is minimum.) Tj
50 307.0 Td
(  2. Scan remaining unsorted elements \(inner loop\).) Tj
50 294.0 Td
(  3. Each comparison checks: is current element smaller than current min?) Tj
50 281.0 Td
(  4. After full inner scan, swap minimum to front of unsorted portion.) Tj
50 268.0 Td
(  5. Advance boundary: unsorted portion shrinks by 1.) Tj
50 255.0 Td
(  6. After n-1 passes, array is fully sorted.) Tj
50 242.0 Td
() Tj
50 229.0 Td
(Complexity:) Tj
50 216.0 Td
(  Best Case  : O\(n^2\)  -- always n\(n-1\)/2 comparisons regardless of input) Tj
50 203.0 Td
(  Worst Case : O\(n^2\)) Tj
50 190.0 Td
(  Average    : O\(n^2\)) Tj
50 177.0 Td
(  Space      : O\(1\) in-place) Tj
50 164.0 Td
() Tj
50 151.0 Td
() Tj
50 138.0 Td
