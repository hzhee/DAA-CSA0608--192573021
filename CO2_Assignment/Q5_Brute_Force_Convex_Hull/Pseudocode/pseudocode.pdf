(Q5 - Brute-Force Convex Hull \(7 Marks\)) Tj
50 671.0 Td
(=======================================) Tj
50 658.0 Td
(Problem: Identify the boundary points of a drone flight zone \(convex hull\).) Tj
50 645.0 Td
() Tj
50 632.0 Td
() Tj
50 619.0 Td
(DESIGN STARTING POINT \(Given\):) Tj
50 606.0 Td
(  An edge from point P_i to point P_j is on the convex hull if and only if) Tj
50 593.0 Td
(  all other points lie on the same side of \(or on\) the line through P_i, P_j.) Tj
50 580.0 Td
() Tj
50 567.0 Td
() Tj
50 554.0 Td
(GEOMETRIC TEST \(Cross Product\):) Tj
50 541.0 Td
(  For edge P_i -> P_j, and any third point P_k:) Tj
50 528.0 Td
(    cross = \(P_j.x - P_i.x\) * \(P_k.y - P_i.y\)) Tj
50 515.0 Td
(          - \(P_j.y - P_i.y\) * \(P_k.x - P_i.x\)) Tj
50 502.0 Td
() Tj
50 489.0 Td
(  Interpretation:) Tj
50 476.0 Td
(    cross > 0  =>  P_k is to the LEFT  of edge P_i->P_j) Tj
50 463.0 Td
(    cross < 0  =>  P_k is to the RIGHT of edge P_i->P_j) Tj
50 450.0 Td
(    cross = 0  =>  P_k is ON the line   \(collinear\)) Tj
50 437.0 Td
() Tj
50 424.0 Td
() Tj
50 411.0 Td
(ALGORITHM: BruteForceConvexHull\(P[0..n-1]\)) Tj
50 398.0 Td
(--------------------------------------------) Tj
50 385.0 Td
(// Find all edges that form the convex hull boundary) Tj
50 372.0 Td
(// Input : Array P of n points) Tj
50 359.0 Td
(// Output: Set of hull edges \(and hull vertices\)) Tj
50 346.0 Td
() Tj
50 333.0 Td
(  hull_edges <- empty set) Tj
50 320.0 Td
(  edge_checks <- 0) Tj
50 307.0 Td
() Tj
50 294.0 Td
(  FOR i <- 0 TO n-1 DO) Tj
50 281.0 Td
(      FOR j <- 0 TO n-1 DO) Tj
50 268.0 Td
(          IF i = j THEN CONTINUE END IF) Tj
50 255.0 Td
(          all_same_side <- TRUE) Tj
50 242.0 Td
(          sign          <- 0) Tj
50 229.0 Td
() Tj
50 216.0 Td
(          FOR k <- 0 TO n-1 DO) Tj
50 203.0 Td
(              IF k = i OR k = j THEN CONTINUE END IF) Tj
50 190.0 Td
(              edge_checks <- edge_checks + 1) Tj
50 177.0 Td
() Tj
50 164.0 Td
(              cross <- \(P[j].x - P[i].x\) * \(P[k].y - P[i].y\)) Tj
50 151.0 Td
(                     - \(P[j].y - P[i].y\) * \(P[k].x - P[i].x\)) Tj
50 138.0 Td
() Tj
50 125.0 Td
(              IF cross != 0 THEN) Tj
50 112.0 Td
(                  IF sign = 0 THEN) Tj
50 99.0 Td
(                      sign <- SIGN\(cross\)) Tj
50 86.0 Td
(                  ELSE IF SIGN\(cross\) != sign THEN) Tj
50 73.0 Td
(                      all_same_side <- FALSE) Tj
ET
endstream
