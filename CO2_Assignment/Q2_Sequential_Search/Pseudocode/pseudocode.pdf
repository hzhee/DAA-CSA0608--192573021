(  Decision Rule:) Tj
50 444.0 Td
(    IF n <= 1,000 AND search_frequency <= 100/day THEN) Tj
50 431.0 Td
(        Sequential Search is APPROPRIATE) Tj
50 418.0 Td
(    ELSE IF n > 1,000 OR search_frequency > 100/day THEN) Tj
50 405.0 Td
(        Sort array ONCE then use Binary Search) Tj
50 392.0 Td
(    END IF) Tj
50 379.0 Td
