(REDESIGNED ALGORITHM: BranchAndBoundKnapsack\(packages, W\)) Tj
50 691.0 Td
(----------------------------------------------------------) Tj
50 678.0 Td
(// Input : packages sorted by value/weight ratio \(descending\)) Tj
50 665.0 Td
(//         W = capacity) Tj
50 652.0 Td
(// Output: best value, best subset, nodes_explored \(vs 2^n\)) Tj
50 639.0 Td
() Tj
50 626.0 Td
(  FUNCTION Bound\(node_weight, node_value, next_item_index\):) Tj
50 613.0 Td
(      // Greedy upper bound on remaining capacity) Tj
50 600.0 Td
(      remaining_cap <- W - node_weight) Tj
50 587.0 Td
(      bound <- node_value) Tj
50 574.0 Td
(      FOR i <- next_item_index TO n-1 DO) Tj
50 561.0 Td
(          IF packages[i].weight <= remaining_cap THEN) Tj
50 548.0 Td
(              bound <- bound + packages[i].value) Tj
50 535.0 Td
(              remaining_cap <- remaining_cap - packages[i].weight) Tj
50 522.0 Td
(          ELSE) Tj
50 509.0 Td
(              bound <- bound + \(remaining_cap / packages[i].weight\) * packages[i].value) Tj
50 496.0 Td
(              BREAK) Tj
50 483.0 Td
(          END IF) Tj
50 470.0 Td
(      END FOR) Tj
50 457.0 Td
(      RETURN bound) Tj
50 444.0 Td
() Tj
50 431.0 Td
(  PROCEDURE Explore\(item_idx, curr_weight, curr_value, curr_selection\):) Tj
50 418.0 Td
(      nodes_explored <- nodes_explored + 1) Tj
50 405.0 Td
() Tj
50 392.0 Td
(      IF item_idx = n THEN) Tj
50 379.0 Td
(          IF curr_value > best_value THEN) Tj
50 366.0 Td
(              best_value     <- curr_value) Tj
50 353.0 Td
(              best_selection <- COPY\(curr_selection\)) Tj
50 340.0 Td
(          END IF) Tj
50 327.0 Td
(          RETURN) Tj
50 314.0 Td
(      END IF) Tj
50 301.0 Td
() Tj
50 288.0 Td
(      // ?? PRUNE: upper bound cannot beat current best ??) Tj
50 275.0 Td
(      IF Bound\(curr_weight, curr_value, item_idx\) <= best_value THEN) Tj
50 262.0 Td
(          RETURN   // Prune this branch) Tj
50 249.0 Td
(      END IF) Tj
50 236.0 Td
() Tj
50 223.0 Td
(      // ?? BRANCH: Include item item_idx ??) Tj
50 210.0 Td
(      IF curr_weight + packages[item_idx].weight <= W THEN) Tj
50 197.0 Td
(          curr_selection[item_idx] <- 1) Tj
50 184.0 Td
(          Explore\(item_idx+1,) Tj
50 171.0 Td
(                  curr_weight + packages[item_idx].weight,) Tj
50 158.0 Td
(                  curr_value  + packages[item_idx].value,) Tj
50 145.0 Td
(                  curr_selection\)) Tj
50 132.0 Td
(          curr_selection[item_idx] <- 0) Tj
50 119.0 Td
(      END IF) Tj
50 106.0 Td
() Tj
50 93.0 Td
(      // ?? BRANCH: Exclude item item_idx ??) Tj
50 80.0 Td
(      Explore\(item_idx+1, curr_weight, curr_value, curr_selection\)) Tj
50 67.0 Td
() Tj
